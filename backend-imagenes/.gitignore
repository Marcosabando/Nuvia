# -------------------------
# 📦 NODE & DEPENDENCIAS
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------------
# 🏗️ BUILD / DIST / TEMP
# -------------------------
dist/
dist-ssr/
temp/
*.tsbuildinfo

# -------------------------
# 🔐 ENTORNOS Y CONFIGS PRIVADAS
# -------------------------
.env.*
config.js    # solo si contiene claves
config/*.local.*

# -------------------------
# 💾 UPLOADS & ARCHIVOS DE USUARIO
# -------------------------
# Ignorar todo lo subido por usuarios (muy recomendable)
uploads/
# Pero mantener la carpeta vacía en el repo:
!uploads/.gitkeep

# Si tienes subcarpetas temporales internas:
uploads/temp/
uploads/*.db

# -------------------------
# 🖥️ SISTEMA OPERATIVO
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# 🛠️ IDEs / TOOLS
# -------------------------
.vscode/
!.vscode/extensions.json
.idea/

# -------------------------
# 🔧 VARIOS
# -------------------------
logs/
*.log

/src/generated/prisma

/src/generated/prisma
